		}
		{
			dependencies: ["29B3FF148DEA0BC2"]
			description: [
				"&lThe Red Mystical Flower&r blows up other flowers around it when it fully grows. Luckily, it only does one adjacent at random."
				""
				"If there are no adjacent flowers, it doesn't blow up anything, catch my drift?"
				""
				"To plant this flower, use (requires a yellow and a magenta petal that will be consumed):"
				""
				"&7turtle.&6plant&7(consts.&6PLANTS&7.&6RED_FLOWER&7)&r"
			]
			disable_toast: true
